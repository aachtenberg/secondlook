# Lab values for the docker compose lab (public, local only). Copy to .env: dbtriage reads it itself.
# For a real setup start from a recipe in recipes/, and see recipes/reference.env for every variable.
PG_DSN=postgresql://dbtriage:dbtriage@localhost:5432/app
MYSQL_DSN=mysql://dbtriage:dbtriage@localhost:3306/app
MARIADB_DSN=mysql://dbtriage:dbtriage@localhost:3307/app
ORACLE_DSN=C##DBTRIAGE/dbtriage@localhost:1521/FREE
# SQL Server lab (compose/sqlserver/k8s.yaml): its login password is generated into the k8s secret mssql
# MSSQL_DSN=mssql://dbtriage:<dbtriage-password>@127.0.0.1:14330/app?trust_server_certificate=yes
# S3-compatible storage (lab): DBTRIAGE_STORAGE=s3://dbtriage/snapshots
AWS_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=dbtriage
AWS_SECRET_ACCESS_KEY=dbtriage-secret
AWS_DEFAULT_REGION=us-east-1
# ANTHROPIC_API_KEY=...   (or `ant auth login`); unset + --no-llm = rules-only triage
