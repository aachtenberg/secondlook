# dbtriage: every environment variable it reads, grouped. Copy the ones you need into the .env next to
# targets.toml (dbtriage reads that file itself and notices edits), or set them in systemd, a container or your
# secret store, which always win over the file. Values here are placeholders.

# ---------------------------------------------------------------- database connections
# Whatever names your targets use in dsn_env. Each needs only a read-only monitoring user.
# PROD_PG_DSN=postgresql://dbtriage:PASSWORD@db.example.com:5432/app
# PROD_MYSQL_DSN=mysql://dbtriage:PASSWORD@db.example.com:3306/app
# PROD_ORACLE_DSN=DBTRIAGE/PASSWORD@db.example.com:1521/ORCLPDB1

# ---------------------------------------------------------------- AI model keys (only the provider you use)
# ANTHROPIC_API_KEY=sk-ant-...           anthropic
# ANTHROPIC_AUTH_TOKEN=...              anthropic, a bearer token instead of an API key
# ANTHROPIC_FOUNDRY_API_KEY=...          foundry
# OPENAI_API_KEY=sk-...                  openai
# OPENROUTER_API_KEY=sk-or-...           openrouter
# GROQ_API_KEY=gsk_...                   groq
# OLLAMA_API_KEY=...                     ollama-cloud (local Ollama needs none)
# VLLM_API_KEY=...                       vllm, when the server asks for one
# AZURE_OPENAI_API_KEY=...               azure-openai
# GOOGLE_OAUTH_ACCESS_TOKEN=...          vertex-gemini, if you would rather not use api_key_cmd
# GOOGLE_CLOUD_PROJECT=my-gcp-project    vertex, vertex-gemini, when project_id is not set
# AWS_PROFILE=dbtriage                   bedrock, bedrock-converse (or any other way of giving AWS credentials)
# AWS_REGION=us-east-1                   bedrock, bedrock-converse, when region is not set
# DBTRIAGE_PROVIDER=ollama               override [agent].provider for one run
# DBTRIAGE_MODEL=qwen3:8b                override [agent].model for one run
# DBTRIAGE_NO_LLM=1                      runs that do not say otherwise (webhooks, the Lambda handler, cloud functions): rules only

# ---------------------------------------------------------------- snapshot storage
# DBTRIAGE_STORAGE=s3://dbtriage/snapshots     overrides [storage].url
# DBTRIAGE_SPOOL=/var/lib/dbtriage/spool       where writes wait while a remote store is down (default ./spool)
# DBTRIAGE_NO_SPOOL=1                          fail writes during an outage instead of spooling them
# S3 and S3-compatible:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=us-east-1
# AWS_ENDPOINT_URL=http://minio:9000           only for non-AWS S3
# Azure Blob (one of these ways):
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...
# AZURE_STORAGE_ACCOUNT=mystorageaccount       with a SAS token, or a managed identity / az login
# AZURE_STORAGE_SAS_TOKEN=sv=...
# AZURE_STORAGE_ENDPOINT=http://127.0.0.1:10000/devstoreaccount1   Azurite, for local testing
# Postgres store: the password is best kept out of the URL
# PGPASSWORD=...

# ---------------------------------------------------------------- delivery secrets
# Whatever names your channels use in *_env. For example:
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# TEAMS_WEBHOOK_URL=https://...
# NTFY_TOKEN=tk_...
# SMTP_USER=dbtriage
# SMTP_PASSWORD=...
# JIRA_USER=dbtriage@example.com
# JIRA_TOKEN=...
# PLANE_API_KEY=...

# ---------------------------------------------------------------- dbtriage itself
# DBTRIAGE_CONFIG=/etc/dbtriage/targets.toml   the config file (default ./targets.toml)
# DBTRIAGE_SETTINGS=postgres://dbtriage@db/ops?schema=dbtriage   where Settings-page changes go; a URL shares them between servers
# DBTRIAGE_NO_OVERLAY=1                        ignore Settings-page changes; use targets.toml alone
# DBTRIAGE_ENV_FILE=/etc/dbtriage/.env         read this file instead of the .env next to the config
# DBTRIAGE_NO_ENV_FILE=1                       read no .env at all
# DBTRIAGE_WEB_TOKEN=...                       a password for the web view (HTTP Basic); leave unset behind single sign-on
# DBTRIAGE_WEBHOOK_TOKEN=...                   the shared secret alert webhooks must send to `dbtriage serve`
# DBTRIAGE_TEST_PG_URL=postgres://...          tests only: run the live Postgres store tests against this database
