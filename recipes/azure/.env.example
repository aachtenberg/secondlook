# Copy to .env next to targets.toml, or pull these from Key Vault into the app's settings.
CRM_DSN=postgresql://dbtriage:CHANGE_ME@crm-flex.postgres.database.azure.com:5432/crm?sslmode=require
ERP_DSN=DBTRIAGE/CHANGE_ME@erp-vm.internal:1521/ERPPDB
AZURE_OPENAI_API_KEY=CHANGE_ME
# The storage account. With a managed identity this is all the storage needs:
AZURE_STORAGE_ACCOUNT=CHANGE_ME_account_name
# Only without a managed identity:
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=acmedbtriage;AccountKey=CHANGE_ME
TEAMS_WEBHOOK_URL=https://CHANGE_ME
SMTP_USER=dbtriage@acme.example
SMTP_PASSWORD=CHANGE_ME
