#!/bin/sh
# Refuse a commit that adds a secret: gitleaks scans the staged changes with the same rules and allowlist as the CI
# scan (.gitleaks.toml). Turn it on once per clone:  git config core.hooksPath .githooks
# A false positive: add the made-up value to .gitleaks.toml's stopwords. Never --no-verify past a real secret.
GITLEAKS="$(command -v gitleaks || echo "$HOME/.local/bin/gitleaks")"
if [ ! -x "$GITLEAKS" ]; then
    echo "pre-commit: gitleaks is not installed, so the commit is refused." >&2
    echo "  Install 8.21.2, the version CI runs: https://github.com/gitleaks/gitleaks/releases/tag/v8.21.2" >&2
    exit 1
fi
exec "$GITLEAKS" git --pre-commit --staged --redact --config .gitleaks.toml --exit-code 1 --no-banner --log-level warn .
